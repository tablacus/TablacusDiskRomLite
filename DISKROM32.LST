                                    POP BC
                                    LD  A,B
                                    OR  A
                                    JP  Z,LDIR_PAGE1_FIN
                                    DEC B
                                    JR  LDIR_PAGE1
                                
                                LDIR_PAGE1_SLT_HLDE:
                                    EX  DE,HL       ;転送方向(DE)→(HL)
