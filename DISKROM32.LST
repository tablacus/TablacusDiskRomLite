001CD1 F2CE 0000                    DW  0
       F2D0                     _LEFT:
001CD3 F2D0 0000                    DW  0
       F2D2                     _DTPS:
001CD5 F2D2 0000                    DW  0
       F2D4                     _DTA:
001CD7 F2D4 0000                    DW  0
       F2D6                     FLG_LDIR:
001CD9 F2D6 00                      DB  0
       F2D7                     _FCB:
001CDA F2D7 0000                    DW  0
