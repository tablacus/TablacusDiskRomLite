001CC3 F2C0 C32400          10      JP  _ENASLT
                                
       F2C3                     _RESULT:
001CC6 F2C3 00                      DB  0
       F2C4                     _BANK:
001CC7 F2C4 00                      DB  0
       F2C5                     _BANK1:
001CC8 F2C5 00                      DB  0
       F2C6                     CLSZ:               ;クラスタサイズ
001CC9 F2C6 0004                    DW  1024
       F2C7                     CLSZ_H  EQU $-1     ;クラスタサイズ上位8ビット
       F2C8                     SECSZ:              ;セクタサイズ
001CCB F2C8 0002                    DW  512
