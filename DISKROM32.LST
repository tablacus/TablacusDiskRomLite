001C99 F296 F7              12      RST 30H
       F297                     ROM_SLT:
001C9A F297 00                      DB  0
001C9B F298 DE47                    DW  ROM_BLOAD
001C9D F29A F5              11      PUSH    AF
001C9E F29B E5              11      PUSH    HL
001C9F F29C CDA5F2          17      CALL    BLOAD_RET
       F29D                     SWC_BLOAD   EQU $-2
001CA2 F29F E1              10      POP HL
001CA3 F2A0 F1              10      POP AF
001CA4 F2A1 FECF             7      CP  0CFH            ;BLOAD
       F2A3                     SWC_BLOAD_M:
001CA6 F2A3 28DB            12      JR  Z,REPLACE_COMMAND
       F2A5                     BLOAD_RET:
001CA8 F2A5 C9              10      RET
       F2A6                     FIX_COPY:
001CA9 F2A6 F7              12      RST 30H
       F2A7                     ROM_SLT_COPY:
001CAA F2A7 00                      DB  0
001CAB F2A8 5F49                    DW  ROM_COPY
001CAD F2AA C9              10      RET
       F2AB                     RAMUSE1:
001CAE F2AB 3A42F3          13      LD  A,(RAMAD1)
001CB1 F2AE 180E            12      JR  _ENASLT_40H
       F2B0                     CAL_MP:
001CB3 F2B0 2640             7      LD  H,040H
001CB5 F2B2 3AC1FC          13      LD  A,(EXPTBL)
001CB8 F2B5 CD2400          17      CALL    _ENASLT
001CBB F2B8 CD1C00          17      CALL    _CALSLT
