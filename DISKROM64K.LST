                                ;
                                ;   ページ2/ページ3
                                ;
                                #if exists USE_NORMAL32K_OR_ASCII16
                                LDIR_PAGE2_0:
                                    RES 7, H
                                    SET 6, H
                                    LD  A,(_BANK)
                                    JP  LDIR_16K
                                #else
0005D4 45D4 EDB0                    LDIR
0005D6 45D6 C9              10      RET
                                #endif
                                
                                #if exists USE_NORMAL32K_OR_ASCII16
                                LDIR_PAGE2_1:           ;ページ1からページ2へ跨ぐ残りの転送
                                    PUSH    BC
                                    PUSH    DE
                                    PUSH    HL
                                    LD  A,(RAMAD2)
                                    LD  H,080H
                                    CALL    _ENASLT     ;ページ2をRAMに戻す(転送先を書き込み可能にする)
                                    POP HL
                                    POP DE
                                    POP BC
                                    CALL    LDIR_PAGE2_0    ;残りをコピーする
                                    JP  LDIRE2      ;SPを復帰して呼び出し元へ戻る
                                #endif
                                ;
                                ;   ディスクからV-RAMへの転送
                                ;
       45D7                     ROM_LDIRVM:
0005D7 45D7 DD215C00        14      LD  IX,LDIRVM
                                #if exists USE_NORMAL32K_OR_ASCII16
                                    RES 7, H
                                    SET 6, H
                                    LD  A,(_BANK)
