0012EC 52EC 48               4      LD  C,B
0012ED 52ED CD1755          17      CALL    GET_DISK_BANK
0012F0 52F0 F5              11      PUSH    AF
0012F1 52F1 3AC9F2          13      LD  A,(SECSZ_H)
