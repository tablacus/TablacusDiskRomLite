       52F9                     SETMAP1:
0012F9 52F9 E5              11      PUSH    HL
       52FA                     DISKIO1:
0012FA 52FA C5              11      PUSH    BC      ;B=残りのセクタ数
0012FB 52FB D5              11      PUSH    DE      ;DE=セクタ番号
0012FC 52FC F5              11      PUSH    AF      ;A=8KB単位でカートリッジ内のディスクが存在する位置を指定
                                
0012FD 52FD EB               4      EX  DE,HL       ;DE=受け取る読み出し先のメモリアドレス HL=セクタ番号
0012FE 52FE F5              11      PUSH    AF
0012FF 52FF 3AC9F2          13      LD  A,(SECSZ_H)
001302 5302 CD3E55          17      CALL    MUL_AHL
001305 5305 F1              10      POP AF
                                #if exists USE_NORMAL32K_OR_ASCII16
                                    LD  A,L
                                    PUSH    BC
                                    LD  BC,-00020H  ;先頭の8KB部分
                                    ADD HL,BC
                                    POP BC
                                    JR  NC,DISKIO2
                                    LD  C,L     ;C=読み出し元
                                    ADD HL,HL   ;64KB→32KB
                                    ADD HL,HL   ;32KB→16KB バンク切り替えのサイズに合わせる
                                    CALL    GET_DISK_BANK_FDRV
                                    ADD A,H
                                    LD  (ASCII16_BANK1_SEL),A   ;ASCII-16K
                                    LD  (_BANK),A
                                    LD  L,C     ;C=読み出し元
                                    LD  A,03FH      ;セグメントのサイズでフィルタする(16K:3F)
                                    AND L
                                    ADD A,020H
                                #else
001306 5306 4D               4      LD  C,L     ;C=読み出し元
001307 5307 29              11      ADD HL,HL       ;64KB→32KB
001308 5308 29              11      ADD HL,HL       ;32KB→16KB
001309 5309 29              11      ADD HL,HL       ;16KB→8KB  バンク切り替えのサイズに合わせる
00130A 530A 84               4      ADD A,H
00130B 530B 320068          13      LD  (BANK1_SEL),A           ;ASCII-8K/Konami-8K
00130E 530E 320070          13      LD  (KONAMI_SCC_BANK1_SEL),A    ;Konami-8K/Konami-SCC
001311 5311 32C4F2          13      LD  (_BANK),A
001314 5314 79               4      LD  A,C     ;C=読み出し元
001315 5315 E61F             7      AND 01FH        ;セグメントのサイズでフィルタする(8K:1F)
                                #endif
