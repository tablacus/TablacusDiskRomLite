       52F9                     DISKIO1:
0012F9 52F9 C5              11      PUSH    BC      ;B=残りのセクタ数
0012FA 52FA D5              11      PUSH    DE      ;DE=セクタ番号
0012FB 52FB F5              11      PUSH    AF      ;A=8KB単位でカートリッジ内のディスクが存在する位置を指定
                                
0012FC 52FC EB               4      EX  DE,HL       ;DE=受け取る読み出し先のメモリアドレス HL=セクタ番号
0012FD 52FD F5              11      PUSH    AF
0012FE 52FE 3AC9F2          13      LD  A,(SECSZ_H)
001301 5301 CD3D55          17      CALL    MUL_AHL
001304 5304 F1              10      POP AF
                                #if exists USE_NORMAL32K_OR_ASCII16
                                    LD  A,L
                                    PUSH    BC
                                    LD  BC,-00020H  ;先頭の8KB部分
                                    ADD HL,BC
                                    POP BC
                                    JR  NC,DISKIO2
                                    LD  C,L     ;C=読み出し元
                                    ADD HL,HL   ;64KB→32KB
                                    ADD HL,HL   ;32KB→16KB バンク切り替えのサイズに合わせる
                                    CALL    GET_DISK_BANK_FDRV
                                    ADD A,H
                                    LD  (ASCII16_BANK1_SEL),A   ;ASCII-16K
                                    LD  (_BANK),A
                                    LD  L,C     ;C=読み出し元
                                    LD  A,03FH      ;セグメントのサイズでフィルタする(16K:3F)
                                    AND L
                                    ADD A,020H
                                #else
001305 5305 4D               4      LD  C,L     ;C=読み出し元
001306 5306 29              11      ADD HL,HL       ;64KB→32KB
001307 5307 29              11      ADD HL,HL       ;32KB→16KB
001308 5308 29              11      ADD HL,HL       ;16KB→8KB  バンク切り替えのサイズに合わせる
