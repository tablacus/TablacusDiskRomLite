       52E7                     DISKIO:
0012E7 52E7 38F6            12      JR  C,ERROR_WRITE_PROTECTED
0012E9 52E9 48               4      LD  C,B
0012EA 52EA CD1455          17      CALL    GET_DISK_BANK
0012ED 52ED F5              11      PUSH    AF
0012EE 52EE 3AC9F2          13      LD  A,(SECSZ_H)
0012F1 52F1 B7               4      OR  A
0012F2 52F2 28EE            12      JR  Z,ERROR_NOT_READY
0012F4 52F4 F1              10      POP AF
       52F5                     SETMAP1:
0012F5 52F5 E5              11      PUSH    HL
       52F6                     DISKIO1:
0012F6 52F6 C5              11      PUSH    BC      ;B=残りのセクタ数
0012F7 52F7 D5              11      PUSH    DE      ;DE=セクタ番号
0012F8 52F8 F5              11      PUSH    AF      ;A=8KB単位でカートリッジ内のディスクが存在する位置を指定
                                
0012F9 52F9 EB               4      EX  DE,HL       ;DE=受け取る読み出し先のメモリアドレス HL=セクタ番号
0012FA 52FA F5              11      PUSH    AF
0012FB 52FB 3AC9F2          13      LD  A,(SECSZ_H)
0012FE 52FE CD3A55          17      CALL    MUL_AHL
001301 5301 F1              10      POP AF
                                #if exists USE_NORMAL32K_OR_ASCII16
                                    LD  A,L
                                    PUSH    BC
                                    LD  BC,-00020H  ;先頭の8KB部分
                                    ADD HL,BC
                                    POP BC
                                    JR  NC,DISKIO2
                                    LD  C,L     ;C=読み出し元
                                    ADD HL,HL   ;64KB→32KB
                                    ADD HL,HL   ;32KB→16KB バンク切り替えのサイズに合わせる
                                    CALL    GET_DISK_BANK_FDRV
                                    ADD A,H
                                    LD  (ASCII16_BANK1_SEL),A   ;ASCII-16K
                                    LD  (_BANK),A
                                    LD  L,C     ;C=読み出し元
                                    LD  A,03FH      ;セグメントのサイズでフィルタする(16K:3F)
                                    AND L
                                    ADD A,020H
                                #else
001302 5302 4D               4      LD  C,L     ;C=読み出し元
001303 5303 29              11      ADD HL,HL       ;64KB→32KB
001304 5304 29              11      ADD HL,HL       ;32KB→16KB
001305 5305 29              11      ADD HL,HL       ;16KB→8KB  バンク切り替えのサイズに合わせる
001306 5306 84               4      ADD A,H
001307 5307 320068          13      LD  (BANK1_SEL),A           ;ASCII-8K/Konami-8K
00130A 530A 320070          13      LD  (KONAMI_SCC_BANK1_SEL),A    ;Konami-8K/Konami-SCC
00130D 530D 32C4F2          13      LD  (_BANK),A
001310 5310 79               4      LD  A,C     ;C=読み出し元
