                                    INCLUDE "FILE.ASM"
                                ;
                                ;   ディスクからメモリへの転送
                                ;
       453D                     ROM_LDIR:
00053D 453D 3AD6F2          13      LD  A,(FLG_LDIR)
000540 4540 B7               4      OR  A
