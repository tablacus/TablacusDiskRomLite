000597 4597 C1              10      POP BC
000598 4598 E1              10      POP HL
000599 4599 D1              10      POP DE
00059A 459A EDA1            16      CPI         ;HL=HL+1 BC=BC-1 BCが0の場合にP/V=0
00059C 459C EA8745          10      JP  PE,LDIR_PAGE1_SLT1
00059F 459F EB               4      EX  DE,HL       ;転送方向(HL)→(DE)
                                #if exists USE_NORMAL32K_OR_ASCII16
                                    JP  LDIRE2
