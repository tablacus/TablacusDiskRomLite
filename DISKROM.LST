00057C 457C E1              10      POP HL
00057D 457D D1              10      POP DE
00057E 457E EDA1            16      CPI         ;HL=HL+1 BC=BC-1 BCが0の場合にP/V=0
000580 4580 EA6B45          10      JP  PE,LDIR_PAGE0_SLT1
