                                ;
                                ;   ページ2/ページ3
                                ;
                                #if exists USE_NORMAL32K_OR_ASCII16
                                LDIR_PAGE2_0:
                                    RES 7, H
                                    SET 6, H
                                    LD  A,(_BANK)
                                    JP  LDIR_16K
                                #else
000548 4548 EDB0                    LDIR
00054A 454A C9              10      RET
                                #endif
                                
                                #if exists USE_NORMAL32K_OR_ASCII16
                                LDIR_PAGE2_1:           ;ページ1からページ2へ跨ぐ残りの転送
                                    PUSH    BC
                                    PUSH    DE
                                    PUSH    HL
                                    LD  A,(RAMAD2)
                                    LD  H,080H
                                    CALL    _ENASLT     ;ページ2をRAMに戻す(転送先を書き込み可能にする)
                                    POP HL
                                    POP DE
                                    POP BC
                                    CALL    LDIR_PAGE2_0    ;残りをコピーする
                                    JP  LDIRE2      ;SPを復帰して呼び出し元へ戻る
                                #endif
                                ;
                                ;   ディスクからV-RAMへの転送
                                ;
       454B                     ROM_LDIRVM:
00054B 454B DD215C00        14      LD  IX,LDIRVM
                                #if exists USE_NORMAL32K_OR_ASCII16
                                    RES 7, H
                                    SET 6, H
                                    LD  A,(_BANK)
                                    PUSH    BC
                                    PUSH    DE
                                    CALL    LDIRVM_16K
                                #else
00054F 454F C5              11      PUSH    BC
000550 4550 D5              11      PUSH    DE
000551 4551 CDEF44          17      CALL    CALSLT_BIOS_PAGE0
                                #endif
000554 4554 E1              10      POP HL
000555 4555 C1              10      POP BC
000556 4556 09              11      ADD HL,BC
000557 4557 EB               4      EX  DE,HL
000558 4558 C9              10      RET
                                ;
                                ;   ページ0/ページ1
                                ;
       4559                     ROM_LDIRSLT:
                                #if exists USE_NORMAL32K_OR_ASCII16
                                    DI
                                    LD  (_SP),SP
                                    LD  A,(_SP_H)
                                    CP  0C0H
                                    JR  NC,SPJ3
                                    LD  SP,SPBUF
                                SPJ3:
                                    PUSH    BC
                                    PUSH    DE
                                    PUSH    HL
                                    LD  A,(ROM_SLT)
                                    LD  H,080H
                                    CALL    _ENASLT
                                    POP HL
                                    POP DE
                                    POP BC
                                #endif
                                                ;ページ0
000559 4559 3A0000          13      LD  A,(0000H)
00055C 455C FEF3             7      CP  0F3H        ;0000H が DI じゃない場合はページ0は RAM とみなす
00055E 455E 280A            12      JR  Z,LDIR_PAGE0_SLT
       4560                     LDIR_PAGE0_1:
000560 4560 CB72             8      BIT 6,D
000562 4562 2022            12      JR  NZ,LDIR_PAGE1
000564 4564 EDA0            16      LDI         ;ページ0 直接転送
000566 4566 EA6045          10      JP  PE,LDIR_PAGE0_1
                                #if exists USE_NORMAL32K_OR_ASCII16
                                LDIRE2:
                                    PUSH    DE
                                    PUSH    HL
                                    LD  A,(RAMAD2)
                                    LD  H,080H
                                    CALL    _ENASLT
                                    POP HL
                                    POP DE
                                LDIRE:
                                    LD  SP,(_SP)
                                #endif
000569 4569 C9              10      RET
                                
       456A                     LDIR_PAGE0_SLT:     ;ページ0 WRSLTを使用
00056A 456A EB               4      EX  DE,HL       ;転送方向(DE)→(HL)
       456B                     LDIR_PAGE0_SLT1:
00056B 456B CB74             8      BIT 6,H
00056D 456D 2018            12      JR  NZ,LDIR_PAGE1_DEHL
00056F 456F 1A               7      LD  A,(DE)
000570 4570 13               6      INC DE
000571 4571 D5              11      PUSH    DE
000572 4572 5F               4      LD  E,A
