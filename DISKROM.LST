       52EB                     DISKIO:
0012EB 52EB 38F6            12      JR  C,ERROR_WRITE_PROTECTED
0012ED 52ED 48               4      LD  C,B
0012EE 52EE CD1855          17      CALL    GET_DISK_BANK
0012F1 52F1 F5              11      PUSH    AF
0012F2 52F2 3AC9F2          13      LD  A,(SECSZ_H)
