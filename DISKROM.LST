                                #else
000584 4584 C9              10      RET
                                #endif
                                
                                ;ページ1転送の終了処理
                                ;_RAM64K の #if の内側では #if exists が展開されないため、終了処理をここで定義して飛ばす
                                #if exists USE_NORMAL32K_OR_ASCII16
                                LDIR_PAGE1_FIN:
                                    JP  LDIRE2
                                #else
