       F30C                     IS_BIOS:            ;C-BIOSの場合は0
001C43 F30C FF                      DB  0FFH
                                
       F30D                     ISCB_E:
[EOF:SLOT.ASM:UTF_8]
       1C44                     LAST    EQU $$
001C44 F30D                         DS  01FFFH-LAST
001FFF F6C8 00                      DB  0
                                
                                    END
