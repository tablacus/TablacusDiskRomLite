                                ;   Tablacus DISK ROM - DISK
                                
                                ;   ROM DISK DRIVER
                                ;   1セクタ512
                                
       52DF                     ERROR_WRITE_PROTECTED:
0012DF 52DF 3E00             7      LD  A,0     ;Write protected
0012E1 52E1 C9              10      RET
       52E2                     ERROR_NOT_READY:
